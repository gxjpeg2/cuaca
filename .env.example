# Salin file ini ke .env. Nilai di sini hanya untuk pemakaian lokal.

PGHOST=localhost
PGPORT=5432
PGDATABASE=cuaca
PGUSER=cuaca
PGPASSWORD=ganti_password_ini

CUACA_TEST_DB=cuaca_test

# Wajib diisi untuk Airflow, minimal 32 karakter. Buat dengan: openssl rand -hex 32
AIRFLOW_JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32
# AIRFLOW_UID=1000
# AIRFLOW_ADMIN_USER=airflow
# AIRFLOW_ADMIN_PASSWORD=airflow
# AIRFLOW_DB_PASSWORD=airflow

# Untuk memakai sumber simulasi:
# OPEN_METEO_FORECAST_URL=http://simulasi:8000/v1/forecast
# OPEN_METEO_ARCHIVE_URL=http://simulasi:8000/v1/archive
# SIMULASI_INTERVAL=60
